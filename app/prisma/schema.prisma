// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String               @id @default(uuid())
  email                String               @unique
  username             String               @unique
  password             String
  role                 Role                 @default(retailer)
  walletAddress        String?
  businessName         String?
  licenseNumber        String?
  documentUrl          String?
  verificationStatus   VerificationStatus   @default(pending)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  pendingRegistration  PendingRegistration?
  Product              Product[]            @relation("ManufacturerProducts")
  RetailerRequests     ProductRequest[]     @relation("RetailerRequests")
  ManufacturerRequests ProductRequest[]     @relation("ManufacturerRequests")
}

model PendingRegistration {
  id            Int                @id @default(autoincrement())
  userId        String             @unique
  role          Role
  businessName  String
  licenseNumber String
  walletAddress String
  documentUrl   String
  status        RegistrationStatus @default(pending)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  user          User               @relation(fields: [userId], references: [id])
}

model Admin {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  manufacturer
  retailer
}

enum VerificationStatus {
  pending
  approved
  rejected
}

enum RegistrationStatus {
  pending
  approved
  rejected
}

model Product {
  id                String            @id @default(uuid())
  productId         String            @unique
  batchNumber       Int
  name              String
  description       String?
  productionDate    BigInt
  status            String            @default("active")
  owner             String
  blockchainAccount String
  manufacturerId    String
  manufacturer      User              @relation("ManufacturerProducts", fields: [manufacturerId], references: [id])
  transfers         ProductTransfer[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}

model ProductTransfer {
  id             String   @id @default(uuid())
  productId      String
  product        Product  @relation(fields: [productId], references: [id])
  retailerWallet String
  transferDate   DateTime @default(now())
  confirmed      Boolean  @default(false)
}

model ProductRequest {
  id             String   @id @default(uuid())
  retailerId     String
  manufacturerId String
  productName    String
  quantity       Int
  status         String   @default("pending") // pending, approved, rejected
  requestDate    DateTime @default(now())
  retailer       User     @relation("RetailerRequests", fields: [retailerId], references: [id])
  manufacturer   User     @relation("ManufacturerRequests", fields: [manufacturerId], references: [id])
}
